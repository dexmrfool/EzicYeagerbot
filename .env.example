# ==============================================================================
# Telegram Multilingual Translator + Butler AI Bot Configuration
# ==============================================================================

# 1. Telegram Bot Credentials (Get from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# 2. Invisible Owner Security (Comma-separated Telegram User IDs)
# These IDs are authorized to use the hidden /enable and /disable commands.
OWNER_IDS=5429173364

# 3. Bot Persona & Default Language
BOT_NAME=Butler
DEFAULT_TARGET_LANGUAGE=en
DEFAULT_TRANSLATION_MODEL=gemini-2.5-flash

# 4. Translation & AI Engine Selection ("gemini" or "openai")
TRANSLATION_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

# 5. Web Search Configuration ("duckduckgo" or "tavily")
# DuckDuckGo works 100% free out of the box with zero API key!
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=

# 6. Database Connection (SQLite by default, or PostgreSQL for high traffic)
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# DATABASE_URL=postgresql+asyncpg://butleruser:secure_db_password_here@postgres:5432/butlerdb

# 7. Memory & Performance Tuning
MEMORY_MAX_MESSAGES=15
MEMORY_TTL_MINUTES=60
TRANSLATION_CACHE_TTL_SECONDS=86400
LOG_LEVEL=INFO
PORT=8080
